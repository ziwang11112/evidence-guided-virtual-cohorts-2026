{
  "schema_version": 1,
  "budgets": {"queries": 12, "downloads": 12, "auxiliary_requests": 80},
  "limits": {"response_bytes": 16777216, "timeout_seconds": 30, "search_page_size": 10, "table_cells": 1000000},
  "exclusions": {
    "compact_aliases": [
      "NHANES", "HANES", "HHANES", "Hispanic Health and Nutrition Examination Survey",
      "National Health and Nutrition Examination Survey", "National Health Nutrition Examination Survey",
      "National Health and Nutrition Examination Study", "National Health Nutrition Examination Study",
      "National Health and Nutritional Examination Survey", "National Health Nutritional Examination Survey",
      "National Health Examination Survey", "National Health Examination Study",
      "Health and Nutrition Examination Survey", "Health Nutrition Examination Survey"
    ],
    "regexes": [
      "\\b(?:SDMVSTRA|SDMVPSU|WTMEC2YR|WTINT2YR|WTSAF2YR|RIDAGEYR|RIAGENDR)\\b"
    ]
  }
}
