  "assumptions": [
    {
      "id": "A_source_selection",
      "description": "Each source context directly samples an assumed complete selected analysis law. Original fasting eligibility, missingness and Table3 selection are not reconstructed; broader descriptive moments are approximate anchors. The urban-men four-record denominator discrepancy is unresolved."
    },
    {
      "id": "A_source_scale",
      "description": "A stratum population BMI SD is approximated by broader fasting-sample descriptive SD. The paper reference population/divisor is unresolved. Replay bmi_z is independently audited sample centering and SD ddof1, not asserted the paper convention. No target SD is used."
    },
    {
      "id": "A_source_design",
      "description": "Full categorical nuisance span with intercept and linear age is implemented. HIV/ART has assumed joint three-state coding. Original contrast and age conventions are not fully specified. Female parity enters only women; structural all-zero rural-women medication-treated indicator contributes no span and is excluded."
    },
    {
      "id": "A_source_estimator",
      "description": "Unweighted OLS point projection is an assumption; source weighting is not explicit. Source household-robust CIs are descriptive and never person-level SD or generated-sample CI. Original finite sample and missingness procedure are not reproduced."
    },
    {
      "id": "A_source_joint",
      "description": "Bounded-beta age and BMI are independent before nuisance generation. Source Table1 marginal weights inform deterministic rounded category quotas; every positive category receives >=1 slot. Conditional weighted ranking without replacement in declared category order supplies assumed dependence. The nuisance age ranking covariate is (age-35.2)/15 years, with the 15-year scale explicitly declared. Quotas and tilt coefficients are not recovered individual data or iid source sampling."
    },
    {
      "id": "A_support",
      "description": "Age and BMI beta supports are finite assumptions [18,90] and [14,55]; not observed extrema. Distribution forms and tails are unverified. Positive conditional lipid means and bounded multiplicative variation require no clipping/rejection."
    },
    {
      "id": "A_nuisance_effects",
      "description": "All nuisance effect vectors are unsupported structural assumptions. Medication, HIV/ART, activity, smoking, alcohol and assets receive bounded nonzero shifts; ethnicity, education, marital status and parity have zero direct effects conditional on the modeled variables. These zeros are explicit restrictions, not evidence from absence."
    },
    {
      "id": "A_level_mapping",
      "description": "Age-standardized Table2 lipid means serve as approximate conditional levels at age35.2, source BMI mean, and baseline-centered nuisance effects. They are not regression intercepts. Linear age effects are assumptions, not recovered source estimates."
    },
    {
      "id": "A_measurement",
      "description": "Coherent fasting assay-scale surrogate: positive HDL plus positive non-HDL gives TC; identity units and source/target measurement correspondence are assumed. This neither deconvolves measurement error nor adds an inferred independent assay-error variance. Coherence is applicable to this construction, not proof that actual independent assays obey exact ordering."
    },
    {
      "id": "A_transport",
      "description": "The same sex/donor-regime raw conditional-mean slopes b_source/SD_source, nuisance effects and component variation are shared by source and target. Equality across Malawi and target is an unsupported transport assumption. Donor regime does not assert target geography/ethnicity."
    },
    {
      "id": "A_target_law",
      "description": "Target F/M probabilities0.5, independent donor regimes0.5, age18+62*Beta(2,4), donor-anchored BMI and nuisance laws are a declared synthetic scenario; target demographic/lifestyle mix and selection are unidentified."
    },
    {
      "id": "A_dispersion",
      "description": "Component CVs0.25, bounded error shape and conditional component correlation q=0 are free reference-scenario assumptions, not source estimates. Alternative q values[-0.75,0,0.75] are analytic sensitivity cases without probability weights. CIs do not identify these parameters."
    },
    {
      "id": "A_related_source",
      "description": "Soares2020 overlaps MEIRU, selects different urban ages and imputes covariates. Its four adult estimates are related-source context only, not independent precision or extra fitting targets; S9/FigureS4 reporting/scale issues remain unresolved."
    },
    {
      "id": "A_scale_sensitivity",
      "description": "Pooled broader-source SD versus stratum SD is a declared analytic alternative. It is not an asserted original convention or an empirical uncertainty interval; denominator mismatch remains in both."
    }
  ],
