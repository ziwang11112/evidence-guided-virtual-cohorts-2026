  "assumptions": [
    {
      "id": "task_scope",
      "description": "Generate exactly3000 independent synthetic persons with six required columns and no observed rows. Complete-case selected analytical population; no national survey weights."
    },
    {
      "id": "hainan_transport",
      "description": "Transport Hainan sex proportions, HbA1c/glucose means/SDs and within-sex HbA1c-glucose rank correlations to the target despite unknown source dates/age limits, geography and clinical selection. Preserve glycaemic margins while changing age distribution; this is not literal source age restriction."
    },
    {
      "id": "jdpp_transport",
      "description": "Transport JDPP sex-specific BMI medians/quartile spread and unadjusted BMI-HbA1c Pearson correlations from Japanese IGT ages30-60 to Chinese ages35-74 with diabetes/treatment included. Source population mixing is scientifically uncertain, not identified by evidence. No numeric correction for selection is invented."
    },
    {
      "id": "copula_family",
      "description": "Within sex use a four-dimensional Gaussian copula. This is one positive-definite joint completion of incomplete evidence, not an estimated joint law. All sources are observational; arrows in computational generation carry no causal meaning."
    },
    {
      "id": "marginal_family",
      "description": "BMI is lognormal; HbA1c is3.5 plus a lognormal; glucose is2.0 plus a lognormal. Floors are regularization assumptions to prevent implausible low-tail values, not hard biological limits. The lognormal upper tails and full aggregate diabetes/treatment mixture are unvalidated. No explicit latent treatment status or diabetes prevalence is inferred."
    },
    {
      "id": "age_distribution",
      "description": "Age is discrete35,...,74. Probability of integer a is normal(mu,sigma) mass on[a-0.5,a+0.5] divided by mass on[34.5,74.5], using Hainan sex-specific mean/SD as untruncated normal parameters. This lowers SD and shifts mean. Normality and integer rounding convention are assumptions."
    },
    {
      "id": "missing_dependencies",
      "description": "Latent Gaussian correlations age-BMI=0.10, age-glucose=0.20 and BMI-glucose=0.25 in both sexes. No admitted source estimates these three quantities. They are moderate-dependence scenario choices, not zero-by-absence assumptions, and influence adjusted BMI strongly."
    },
    {
      "id": "age_association_transport",
      "description": "Use the NHANES adjusted cross-sectional age magnitude0.010 percent/year as a within-sex unweighted population OLS calibration under the constructed BMI/glucose margins. A source survey-weighted pooled US nondiabetic slope does not establish this common within-sex target law; this is an explicit transport/homogeneity assumption. FOS0.012 with extra2hPG is not averaged with it."
    },
    {
      "id": "measurement_identity",
      "description": "Use source fasting plasma glucose numerical values as a baseline scenario for target central serum glucose in mmol/L and assume no extra fasting-adherence contamination or assay offset. Such contamination is unmeasured, not known absent. HbA1c assay equivalence also unverified; no conversion other than declared native units is performed."
    },
    {
      "id": "source_operator_scope",
      "description": "Feedback computes only target-output summaries with matching declared numerical operators. It does not reconstruct any source population. Raw differences can reflect transport, age remapping, selected-population mixing and finite sampling; they are not significance tests or an optimization objective."
    },
    {
      "id": "uncertainty_scope",
      "description": "Within-row residual randomness models individual variation only. Reported source SD is not SE. No source CI level, posterior probability or precision weight is invented. Structural and transport uncertainty is documented but not calibrated by repeated rows."
    },
    {
      "id": "source_missingness",
      "description": "Hainan descriptions concern the stated sex strata; use all available complete synthetic rows for raw mean/rank comparisons. Hainan does not detail variable-specific missingness; source n metadata denotes reported stratum size, not verified complete-pair count. JDPP correlations used pairwise-complete source data with analysis-specific n not supplied."
    },
    {
      "id": "incompatible_models",
      "description": "Do not impose LifeLines rich adjusted BMI slopes or Hoorn body-composition-adjusted quartile contrasts on the target four-predictor regression. Their omitted covariate joint laws are unavailable. Quarantined Hainan regression orientation/scale and JDPP Beta scale remain unresolved."
    }
  ],
