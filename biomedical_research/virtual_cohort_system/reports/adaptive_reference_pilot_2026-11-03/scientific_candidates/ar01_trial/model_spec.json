  "assumptions": [
    {
      "id": "A_DESIGN",
      "description": "3000 iid synthetic people per prescribed seed; row count is design, not evidence. No participant data."
    },
    {
      "id": "A_SCAFFOLD",
      "description": "Age, BMI, female and latent-mixture innovations independent; no female biomarker term. Unidentified simplifying assumptions, not evidence of independence."
    },
    {
      "id": "A_AGE",
      "description": "Discrete maximum entropy on 35..74 with CDF(38)=.09, CDF(52)=.49, CDF(67)=.89 inside reference quantile bins."
    },
    {
      "id": "A_BMI",
      "description": "Bounded lognormal BMI 10..55 approximating mean/SD; clipping has negligible theoretical mass but is an assumption."
    },
    {
      "id": "A_MIXTURE",
      "description": "Two bounded lognormal baseline components, shared membership, Gaussian copula by component. Broad probability constrained to .02..16; tail shape and membership are not identified or clinical classes."
    },
    {
      "id": "A_MOMENTS",
      "description": "CHNS sample reference moments treated as developmental fitting targets. Algebra exploits the scaffold independence; not causal and not independent validation."
    },
    {
      "id": "A_CORE_RHO",
      "description": "Core latent Gaussian correlation 0.40 chosen as first-trial assumption; broad correlation solves baseline covariance using 64-point Gauss-Hermite quadrature without random draws."
    },
    {
      "id": "A_SUPPORT",
      "description": "Baseline glucose support 2.5..25 and HbA1c 3.5..16, bounded age/BMI additive shifts preserve positivity and finite all moments. These are assumed, not reference extrema."
    },
    {
      "id": "A_ROUND",
      "description": "Glucose rounded 2 decimals; HbA1c 1 decimal as unverified measurement-resolution approximation; changes expected moments slightly."
    },
    {
      "id": "A_NUMERICS",
      "description": "Probability clipped at 1e-15 for finite inverse-normal numerics, then scientific bounds enforced."
    }
  ],
