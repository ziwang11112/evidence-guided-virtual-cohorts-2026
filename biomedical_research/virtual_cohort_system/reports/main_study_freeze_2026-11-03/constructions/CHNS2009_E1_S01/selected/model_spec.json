  "assumptions": [
    {
      "id": "A_family",
      "description": "Fixed positive Gaussian-copula reference. Source moment constraints are fitted separately in their declared source contexts; no cross-source loss or target fitting."
    },
    {
      "id": "A_missing_dependence",
      "description": "Unspecified continuous dependence is completed by a latent-Gaussian entropy objective. Independent binary sex is a declared simplification. Local constrained optimization does not certify a global entropy optimum."
    },
    {
      "id": "A_source_semantics",
      "description": "Source moments describe a qualified equal-weight analysis-population scenario. Known glucose/age support is represented in the declared margins; unavailable selection variables, assay differences and survey weights remain limitations."
    },
    {
      "id": "A_transport",
      "description": "Target biomarkers inherit the source-context marginal/copula laws through a prespecified donor rule. This is an unverified transport assumption, not target population estimation."
    },
    {
      "id": "A_uncertainty",
      "description": "Published point summaries are fixed inputs. No source-estimate, structural or transport uncertainty is calibrated. SDs remain individual variability; SEs are not converted to SDs."
    },
    {
      "id": "A_sampling",
      "description": "One random draw under each scheduled seed, without moment forcing, clipping, seed selection, rejection redraws or calibration inside the generator. Invalid floating-point output fails the attempt."
    },
    {
      "id": "A_chns_composition",
      "description": "Equal donor probabilities are not empirical target mixture weights. Target age is discrete uniform on the requested support; source sex fractions are retained by donor. No CHNS target demographic moments are used."
    },
    {
      "id": "A_task",
      "description": "The bound research task determines case, row count, variables, units and explicit support/design; no reference outcome supplies these values."
    },
    {
      "id": "A_information",
      "description": "The bound E0/E1 packet determines the allowed source information. The reference's actual numerical uptake and declined records are retained in the separate construction trace."
    }
  ],
