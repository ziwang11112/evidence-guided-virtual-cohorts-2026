{
  "schema_version": 1,
  "purpose": "Create a complete virtual adult cohort suitable for the requested biomedical analysis. This is a developmental system demonstration using external published evidence.",
  "analyses": [
    "hba1c ~ 1 + bmi + age + female"
  ],
  "task": {
    "schema_version": 1,
    "task_id": "live-system-A",
    "mode": "whole_cohort",
    "population": "Age 35-74, both sexes, common complete-case measurement availability; no diabetes/treatment exclusions; not national representation.",
    "row_id": "person_id",
    "n_rows": 3000,
    "columns": [
      {
        "name": "person_id",
        "kind": "string",
        "unit": "identifier",
        "role": "identifier",
        "nullable": false
      },
      {
        "name": "age",
        "kind": "integer",
        "unit": "years",
        "role": "generated",
        "nullable": false,
        "minimum": 35,
        "maximum": 74
      },
      {
        "name": "female",
        "kind": "integer",
        "unit": "indicator",
        "role": "generated",
        "nullable": false,
        "minimum": 0,
        "maximum": 1
      },
      {
        "name": "bmi",
        "kind": "number",
        "unit": "kg/m^2",
        "role": "generated",
        "nullable": false,
        "minimum": 0
      },
      {
        "name": "hba1c",
        "kind": "number",
        "unit": "percent",
        "role": "generated",
        "nullable": false,
        "minimum": 0
      }
    ],
    "information_policy": {
      "mode": "published_evidence",
      "excluded_cohorts": [
        "CHNS",
        "China Health and Nutrition Survey"
      ],
      "allowed_tools": [
        "literature.search",
        "literature.fetch",
        "literature.list-supplements",
        "literature.fetch-supplement"
      ]
    },
    "budget": {
      "source_queries": 8,
      "source_downloads": 3,
      "revisions": 1
    }
  }
