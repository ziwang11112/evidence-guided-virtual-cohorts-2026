  "findings": [
    {
      "id": "INITIAL-A-01",
      "candidate": "b1/candidates/initial",
      "classification": "limitation",
      "blocking": false,
      "title": "Declared covariance closure and source-level transport do not identify the target joint distribution",
      "detail": "Candidate A is a coherent shared linear-Gaussian scenario. Its residual correlation 0.30, covariate age/sex trends, zero direct HbA1c female term and common residual law are assumptions. Its Pani anchor is an unweighted-count mixture of survey-weighted age-band means, explicitly approximate rather than a recovered survey mean. These choices determine the conditional BMI decomposition and transported location; source projection agreement cannot validate the unreported covariance, Mexico transport or older-age linearity.",
      "disposition": "Accept for the already planned source-only execution within the separate root release. Preserve the limitation and all fixed discrepancies; no scientific repair or coefficient change is requested."
    },
    {
      "id": "INITIAL-B-01",
      "candidate": "b2/candidates/initial",
      "classification": "limitation",
      "blocking": false,
      "title": "One-band HbA1c anchoring and the same covariance closure leave an assumption-dependent scenario",
      "detail": "Candidate B has coherent common covariance/projection algebra. Its target and Pani use the same 5.40% level at assumed age 52/female fraction 0.5, grounded in the published 50-54 band but dependent on assumed band covariates. Residual correlation 0.30, mild covariate trends, zero direct female term, Gaussian shape and shared residual dispersion are explicit assumptions. The positive linear age law may miss the acknowledged older-age plateau; the source checks remain approximate and cannot establish target validity.",
      "disposition": "Accept for the already planned source-only execution within the separate root release. Retain the fixed panel and uncertainty statements; no forced diversification or target-favorable coefficient change is requested."
    }
  ],
