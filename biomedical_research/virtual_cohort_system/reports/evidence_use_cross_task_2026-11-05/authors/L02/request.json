      "quantity": "5 times BMI coefficient",
      "analysis_unit": "mg/dL per 5 kg/m^2"
    },
    {
      "id": "K02-TC-BMI",
      "formula": "total_cholesterol ~ 1 + age + I(sex==F) + bmi",
      "estimator": "unweighted OLS",
      "quantity": "5 times BMI coefficient",
      "analysis_unit": "mg/dL per 5 kg/m^2"
    },
    {
      "id": "K02-LIPID-RESIDUAL",
      "estimator": "Pearson correlation of TC and HDL residuals from the two above models fitted on the same eligible rows",
      "analysis_unit": "1",
      "covariates": [
        "intercept",
        "age",
        "I(sex==F)",
        "bmi"
      ]
    }
  ],
