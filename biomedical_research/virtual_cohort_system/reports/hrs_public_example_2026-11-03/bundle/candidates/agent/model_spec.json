        "rule_hba1c"
      ],
      "assumption_ids": [
        "plugin_source_law",
        "source_recursive_factorization",
        "static_baseline_covariates"
      ],
      "derivation": "Conditional mean exp(X beta); Gamma shape 1/phi and scale phi*mean, so conditional variance=phi*mean^2. Do not confuse dispersion and SD or use coefficient SE as individual noise."
    },
    "memory_model": {
      "evidence_ids": [
