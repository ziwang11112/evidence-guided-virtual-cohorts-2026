        "memory_random_effect_correlation",
        "memory_residual_variance",
        "rule_memory_distribution",
        "rule_visit_design"
      ],
      "assumption_ids": [
        "plugin_source_law",
        "source_recursive_factorization",
        "reference_coding",
        "variance_precision",
        "no_empirical_validation"
      ],
      "derivation": "Apply all 16 fixed effects including both centered HbA1c spline-age interactions. Subject b0=sqrt(v0)*z0, b1=sqrt(v1)*(rho*z0+sqrt(1-rho^2)*z1); add b0+age60*b1 and independent visit error sqrt(ve)*z. Parameters are fixed; no desired coefficient, SE or p-value calibration is performed."
    }
