  "assumptions": [
    {
      "id": "task_design",
      "description": "The task fixes 11,509 synthetic subjects and four balanced visits at years 0,2,4,6, totaling 46,036 rows. This intentionally differs from the 43,500 observed HRS visits; no attrition or informative missingness is modeled."
    },
    {
      "id": "plugin_source_law",
      "description": "Treat the public printed coefficients and variance components as the fixed data-generating law. The numbers are rounded source estimates, not exact underlying biological constants. Coefficient SEs are retained as evidence but no parameter-uncertainty draw is performed because their full covariance matrix is unavailable."
    },
    {
      "id": "source_recursive_factorization",
      "description": "Use the original sequential conditional models and Gaussian/Gamma sampling laws. Innovations, subject random effects and visit residuals are independent except the specified intercept-slope correlation. This is a construction assumption encoded by the source method, not a demonstrated independence of all omitted biological variables."
    },
    {
      "id": "static_baseline_covariates",
      "description": "Sex, race, education, childhood SES and baseline HbA1c are repeated unchanged at all four visits, as in the original simulation. Only age and the memory outcome vary over visits. Time-varying glycemic trajectories, treatments, mortality and dropout are unmodeled."
    },
    {
      "id": "within_age_bin_uniform",
      "description": "Use the original uniform age rule, including ages 80 to 100 in the final bin; exact within-bin age distributions are unavailable. Population tail behavior inherited from this rule is assumption-dependent."
    },
    {
      "id": "reference_coding",
      "description": "Use female/white/College as references and relabel original Female/White to task lowercase labels. College multinomial logit coefficients are zero only for reference identification. No numeric rescaling of childhood SES or memory is possible from the admitted files."
    },
    {
      "id": "synthetic_identifiers",
      "description": "Create sequential labels synthetic_00001 etc. and a distinct suffix for each visit; these contain no participant identifiers."
    },
    {
      "id": "variance_precision",
      "description": "Use the reported variance column 0.373813, 0.007483 and 0.576884, deriving SDs by square roots instead of squaring separately rounded printed SDs. Derive intercept-slope covariance with the reported rounded correlation 0.28. Exact higher precision parameters were not supplied."
    },
    {
      "id": "no_empirical_validation",
      "description": "No HRS-configured generator execution, sampled cohort, clinical model fit or output-based parameter change is authorized during preparation. Static and analytic checks establish internal implementation/contract consistency only. Repeated final seeds measure Monte Carlo variation under one fixed law and do not add independent source evidence."
    }
  ],
