{
  "schema_version": "hrs-output-v1",
  "columns": {
    "id": {
      "dtype": "string",
      "unique": true
    },
    "subject_id": {
      "dtype": "string"
    },
    "visit_time": {
      "dtype": "number",
      "unit": "years after baseline",
      "allowed_values": [
        0,
        2,
        4,
        6
      ]
    },
    "baseline_age": {
      "dtype": "number",
      "unit": "years"
    },
    "age": {
      "dtype": "number",
      "unit": "years"
    },
    "age60": {
      "dtype": "number",
      "unit": "decades centered at 60 years"
    },
    "sex": {
      "dtype": "category",
      "levels": [
        "female",
        "male"
      ]
    },
    "race": {
      "dtype": "category",
      "levels": [
        "white",
        "black"
      ]
    },
    "educ": {
      "dtype": "category",
      "levels": [
        "College",
        "HS",
        "LessThanHS"
      ]
    },
    "cses": {
      "dtype": "number",
      "unit": "source composite score"
    },
    "hba1c": {
      "dtype": "number",
      "unit": "percent",
      "strictly_positive": true
    },
    "mem_s": {
      "dtype": "number",
      "unit": "source standardized delayed recall score"
    }
  },
  "n_subjects": 11509,
  "n_rows": 46036,
  "required_column_order": [
    "id",
    "subject_id",
    "visit_time",
    "baseline_age",
    "age",
    "age60",
    "sex",
    "race",
    "educ",
    "cses",
    "hba1c",
    "mem_s"
  ],
  "baseline_constant_fields": [
    "baseline_age",
    "sex",
    "race",
    "educ",
    "cses",
    "hba1c"
  ],
  "constraints": [
    "Exactly one row per subject and visit time",
    "age=baseline_age+visit_time",
    "age60=(age-60)/10",
    "No missing values"
  ]
}
