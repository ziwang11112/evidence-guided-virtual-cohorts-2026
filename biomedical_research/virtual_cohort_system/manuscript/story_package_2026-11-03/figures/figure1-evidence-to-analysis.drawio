<mxGraphModel dx="1000" dy="560" grid="0" page="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Evidence-guided virtual data for a declared scientific use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#172b4d;fontFamily=Arial;fontSize=24;spacing=12;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="930" height="45" as="geometry" /></mxCell><mxCell id="studies" value="Published study reports&lt;br&gt;Curated external sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#b8c1cc;fontColor=#172b4d;fontFamily=Arial;fontSize=16;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="205" height="65" as="geometry" /></mxCell><mxCell id="request" value="Target population&lt;br&gt;Visible research questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#b8c1cc;fontColor=#172b4d;fontFamily=Arial;fontSize=16;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="75" width="205" height="65" as="geometry" /></mxCell><mxCell id="reference" value="Real-sample estimates&lt;br&gt;Withheld from constructors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f1e8;strokeColor=#b8c1cc;fontColor=#172b4d;fontFamily=Arial;fontSize=16;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="75" width="205" height="65" as="geometry" /></mxCell><mxCell id="packet" value="&lt;b&gt;1  Qualify evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Population and eligibility&lt;br&gt;Measurement and units&lt;br&gt;Statistic and adjustment&lt;br&gt;Estimate and uncertainty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f7;strokeColor=#b8c1cc;fontColor=#172b4d;fontFamily=Arial;fontSize=16;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="185" width="205" height="165" as="geometry" /></mxCell><mxCell id="agent" value="&lt;b&gt;2  Agent constructs law&lt;/b&gt;&lt;br&gt;&lt;br&gt;Joint model and parameters&lt;br&gt;Numerical evidence use&lt;br&gt;Explicit completion and&lt;br&gt;transport assumptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3f0;strokeColor=#007f7c;fontColor=#172b4d;fontFamily=Arial;fontSize=16;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="185" width="205" height="165" as="geometry" /></mxCell><mxCell id="data" value="&lt;b&gt;3  Generate virtual data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Execute the authored law&lt;br&gt;Age, sex, BMI, glucose,&lt;br&gt;and HbA1c&lt;br&gt;&lt;b&gt;No individual inputs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f3f0;strokeColor=#007f7c;fontColor=#172b4d;fontFamily=Arial;fontSize=16;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="185" width="205" height="165" as="geometry" /></mxCell><mxCell id="analysis" value="&lt;b&gt;4  Assess scientific use&lt;/b&gt;&lt;br&gt;&lt;br&gt;All requested regressions&lt;br&gt;Direction and effect size&lt;br&gt;Joint/distribution checks&lt;br&gt;Case-specific uncertainty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f1e8;strokeColor=#b8c1cc;fontColor=#172b4d;fontFamily=Arial;fontSize=16;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="185" width="205" height="165" as="geometry" /></mxCell><mxCell id="roles" value="Evidence roles&lt;br&gt;&lt;b&gt;Reported / derived / assumed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafbfc;strokeColor=#b8c1cc;fontColor=#172b4d;fontFamily=Arial;fontSize=15;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="300" height="60" as="geometry" /></mxCell><mxCell id="feedback" value="Optional generated-data diagnostics&lt;br&gt;Bounded revision, retention or stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafbfc;strokeColor=#b8c1cc;fontColor=#172b4d;fontFamily=Arial;fontSize=15;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="390" width="325" height="60" as="geometry" /></mxCell><mxCell id="scope" value="Main study: 2 development cases; E0 marginal/basic evidence versus E1 added relations.&lt;br&gt;References were previously exposed to researchers. Arrows indicate data flow, not biological causation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#172b4d;fontFamily=Arial;fontSize=15;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="925" height="60" as="geometry" /></mxCell><mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#43546b;strokeWidth=1.6;" edge="1" source="studies" target="packet" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#43546b;strokeWidth=1.6;" edge="1" source="request" target="agent" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#43546b;strokeWidth=1.6;" edge="1" source="reference" target="analysis" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#43546b;strokeWidth=1.6;" edge="1" source="packet" target="agent" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#43546b;strokeWidth=1.6;" edge="1" source="agent" target="data" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;end