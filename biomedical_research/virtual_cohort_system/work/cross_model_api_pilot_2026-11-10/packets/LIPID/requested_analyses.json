{
  "purpose": "Construct one joint adult cohort supporting the three supplied lipid associations. These are descriptive projections, not intervention effects.",
  "row_weighting": "equal weight",
  "design_columns": [
    "1",
    "(age-50)/10",
    "I(sex=='F')",
    "(bmi-25)/5"
  ],
  "outcome_unit_conversion": {
    "total_cholesterol": 38.67,
    "hdl_cholesterol": 38.67
  },
  "conversion_scope": "Delivered mmol/L converted to mg/dL for slopes; numerical units only, not assay equivalence.",
  "eligibility": {
    "minimum_age_inclusive": 18,
    "age_boundary_origin": "investigator-selected prospective use case",
    "age_maximum": null,
    "recognized_sex_categories": [
      "F",
      "M"
    ],
    "common_finite_complete_variables": [
      "age",
      "sex",
      "bmi",
      "total_cholesterol",
      "hdl_cholesterol"
    ],
    "strictly_positive": [
      "bmi",
      "total_cholesterol",
      "hdl_cholesterol"
    ],
    "additional_exclusions": [],
    "no_inferred_exclusions": [
      "pregnancy",
      "HIV",
      "diabetes",
      "fasting",
      "lifestyle",
      "outliers",
      "TC>=HDL"
    ]
  },
  "analyses": [
    {
      "id": "K02-HDL-BMI",
      "formula": "hdl_cholesterol ~ 1 + age + I(sex==F) + bmi",
      "estimator": "unweighted OLS",
      "quantity": "5 times BMI coefficient",
      "analysis_unit": "mg/dL per 5 kg/m^2"
    },
    {
      "id": "K02-TC-BMI",
      "formula": "total_cholesterol ~ 1 + age + I(sex==F) + bmi",
      "estimator": "unweighted OLS",
      "quantity": "5 times BMI coefficient",
      "analysis_unit": "mg/dL per 5 kg/m^2"
    },
    {
      "id": "K02-LIPID-RESIDUAL",
      "estimator": "Pearson correlation of TC and HDL residuals from the two above models fitted on the same eligible rows",
      "analysis_unit": "1",
      "covariates": [
        "intercept",
        "age",
        "I(sex==F)",
        "bmi"
      ]
    }
  ]
}
