{
  "task": {
    "schema_version": 1,
    "mode": "whole_cohort",
    "population": "The peso_lab-weighted complete-case adult distribution in the PNS 2013 laboratory-substudy release, not asserted to be nationally representative: baseline age 20–79, recorded sex 1/2, dictionary-admissible weight/height and final interview SBP/DBP, positive finite laboratory weight. Exclude reported baseline pregnancy; unknown/inapplicable pregnancy retained. No HbA1c, treatment or hypertension restriction. Generated equal-weight rows represent this defined analytical distribution under explicit transport assumptions. Baseline BP timing and unknown released final-reading aggregation must be retained as measurement limitations.",
    "row_id": "row_id",
    "n_rows": 3000,
    "columns": [
      {
        "name": "row_id",
        "kind": "integer",
        "unit": "",
        "role": "identifier",
        "nullable": false
      },
      {
        "name": "age",
        "kind": "number",
        "unit": "years at baseline",
        "role": "generated",
        "nullable": false,
        "minimum": 20,
        "maximum": 79
      },
      {
        "name": "female",
        "kind": "category",
        "unit": "recorded sex: 0 male, 1 female",
        "role": "generated",
        "nullable": false,
        "categories": [
          0,
          1
        ]
      },
      {
        "name": "bmi",
        "kind": "number",
        "unit": "kg/m^2",
        "role": "generated",
        "nullable": false
      },
      {
        "name": "sbp",
        "kind": "number",
        "unit": "mmHg",
        "role": "generated",
        "nullable": false
      },
      {
        "name": "dbp",
        "kind": "number",
        "unit": "mmHg",
        "role": "generated",
        "nullable": false
      }
    ],
    "task_id": "pns_joint_evidence_followup_v1",
    "information_policy": {
      "mode": "published_evidence",
      "excluded_cohorts": [
        "PNS",
        "Pesquisa Nacional de Saude",
        "National Health Survey Brazil",
        "evidence-guided-virtual-cohorts",
        "From Published Evidence to Analyzable Biomedical Cohorts"
      ],
      "allowed_tools": []
    },
    "budget": {
      "source_queries": 0,
      "source_downloads": 0,
      "revisions": 0
    }
  },
  "model": {
    "name": "bounded_conditional_joint_bp_v1",
    "interpretation": "An assumed equal-weight approximation to the declared peso_lab-weighted complete-case analytical population, not a fitted or nationally representative PNS distribution.",
    "age": {
      "distribution": "mixture_of_uniform_intervals",
      "edges": [
        20,
        35,
        50,
        65,
        79
      ],
      "probabilities": [
        0.3,
        0.3,
        0.25,
        0.15
      ]
    },
    "female": {
      "probability": 0.53,
      "independent_of_age": true
    },
    "bmi": {
      "distribution": "conditionally_truncated_lognormal",
      "untruncated_median_expression": "26.5 + 0.6*female + 0.04*(age-45) - 0.002*(age-50)**2",
      "median_intercept": 26.5,
      "median_female_increment": 0.6,
      "median_age_slope": 0.04,
      "median_age_reference": 45,
      "median_age_quadratic": -0.002,
      "median_quadratic_reference": 50,
      "log_sd": 0.2,
      "bounds": [
        14,
        60
      ]
    },
    "bp": {
      "age_reference": 50,
      "age_unit": 10,
      "bmi_reference": 25,
      "bmi_unit": 5,
      "sbp_location": {
        "intercept": 125,
        "age": 6,
        "female": -4,
        "bmi": 3.877
      },
      "dbp_location": {
        "intercept": 78,
        "age": 2,
        "female": -2,
        "bmi": 2.9835,
        "age_hinge_start": 0.5,
        "age_hinge_coefficient": -4
      },
      "errors": {
        "distribution": "variance_standardized_bivariate_student_t",
        "df": 7,
        "latent_correlation": 0.55,
        "sbp_untruncated_sd_at_age20": 14,
        "sbp_untruncated_sd_increment_per_year": 0.07,
        "dbp_untruncated_sd": 9.5
      },
      "conditional_acceptance_region": {
        "sbp_bounds": [
          75,
          260
        ],
        "dbp_bounds": [
          40,
          155
        ],
        "pulse_pressure_bounds": [
          12,
          150
        ]
      },
      "sampling_rule": "Hold age, sex and BMI fixed; redraw the paired BP errors until both BP bounds and the pulse-pressure bounds hold. Locations, error SDs and latent correlation describe the preconstraint law, not necessarily final conditional means, SDs or regression residual correlation."
    }
  }
}